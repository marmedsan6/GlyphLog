{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["/home/mariobox/.local/bin/codebase-memory-mcp"],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "skill": "allow",
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -r /*": "deny",
      "sudo *": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "chmod -R 777*": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "shutdown*": "deny",
      "reboot*": "deny"
    }
  },
  "agent": {
    "qa-senior": {
      "description": "Senior QA engineer that creates test plans, executes E2E tests with Playwright, and generates technical/non-technical reports.",
      "mode": "subagent",
      "model": "anthropic/claude-sonnet-4-6",
      "permission": {
        "edit": "allow",
        "bash": {
          "npx playwright *": "allow",
          "npm test *": "allow",
          "pnpm test *": "allow",
          "*": "ask"
        }
      }
    }
  }
}
