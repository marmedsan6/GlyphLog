{
  "mcpServers": {
    "playwright": {
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    "codebase-memory-mcp": {
      "transport": "stdio",
      "command": "/home/mariobox/.local/bin/codebase-memory-mcp",
      "args": []
    },
    "context7": {
      "transport": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
