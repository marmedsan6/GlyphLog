# ─────────────────────────────────────────────────────────────────────────────
# GlyphLog API — Variables de entorno
#
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Rellena los valores para tu entorno local
#   3. NUNCA commitees el archivo .env
#
# SEGURIDAD:
#   Estas variables contienen secretos reales. Tratar como credenciales.
#   En producción, gestionarlas con el gestor de secretos del PaaS (Railway,
#   Render, etc.), nunca en archivos commiteados.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ────────────────────────────────────────────────────────────
# DSN completo de PostgreSQL con driver asyncpg (requerido para SQLAlchemy async).
# Formato: postgresql+asyncpg://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql+asyncpg://glyphlog:glyphlog@localhost:5432/glyphlog

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT. MÍNIMO 32 caracteres aleatorios.
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
# O con:       openssl rand -hex 32
#
# NUNCA usar este valor de ejemplo en producción.
# La app NO ARRANCA si esta clave tiene menos de 32 caracteres.
SECRET_KEY=REEMPLAZAR_ejecuta_python_c_import_secrets_print_secrets_token_hex_32

# Algoritmo de firma JWT. HS256 es el estándar para tokens simétricos.
# No cambiar sin evaluar las implicaciones de seguridad.
ALGORITHM=HS256

# Minutos de validez del token de acceso. 60 = 1 hora.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Configuración de la aplicación ──────────────────────────────────────────
# true  → activa Swagger UI (/docs), ReDoc (/redoc) y logs SQL detallados.
# false → desactiva toda la documentación interactiva (obligatorio en producción).
DEBUG=true

# Orígenes permitidos para CORS, separados por coma.
# Desarrollo: el puerto de Vite. Producción: dominio real del frontend.
# NUNCA usar * en producción — expone la API a cualquier origen.
# Formato JSON requerido por pydantic-settings 2.x (lista de strings).
ALLOWED_ORIGINS=["http://localhost:5173"]

# ─── Google OAuth (opcional) ────────────────────────────────────────────────
# Client ID de la aplicación web creada en Google Cloud Console.
# Se usa para validar los id_tokens emitidos por Google Sign-In en el
# endpoint POST /api/v1/auth/google.
#
# Si se deja vacío:
#   - La app arranca normalmente.
#   - El endpoint de Google OAuth responde 503 "Login con Google no está
#     disponible en este momento".
#   - El resto de funcionalidades (email/password) sigue funcionando.
#
# Cómo obtenerlo:
#   1. Crear (o seleccionar) un proyecto en https://console.cloud.google.com
#   2. Configurar la pantalla de consentimiento OAuth
#   3. Crear credenciales de tipo "ID de cliente OAuth" → "Aplicación web"
#   4. Añadir los orígenes autorizados (ej: http://localhost:5173)
#   5. Copiar el "ID de cliente" resultante aquí
#
# El MISMO valor debe ir en apps/web/.env.local como VITE_GOOGLE_CLIENT_ID
# para que el botón de Google se renderice en el frontend.
GOOGLE_CLIENT_ID=

# ─── RAWG API (Videojuegos - opcional) ───────────────────────────────────────
# API Key de RAWG para buscar videojuegos en catálogo externo.
# Obtener una gratis registrándote en https://rawg.io/apidocs
# Si se deja vacío, la búsqueda se degradará graciosamente omitiendo videojuegos.
RAWG_API_KEY=

# ─── YouTube API (Descubrimiento - opcional) ──────────────────────────────────
# API Key de YouTube Data API v3 para analizar canales y vídeos.
# Obtener una gratis en https://console.cloud.google.com/apis/credentials
# Si se deja vacío, el endpoint de YouTube discovery responde con 503.
# Quota diaria: 10,000 units (1 búsqueda = 100 units).
YOUTUBE_API_KEY=
# ─── GlyphAI (Chat IA - opcional) ─────────────────────────────────────────────
# Proveedor activo del chat: "openai" (default) o "anthropic".
# Si la API key del proveedor elegido está vacía, POST /api/v1/ai/chat
# responde 503 "AI service not configured" — el resto de la app sigue funcionando.
#
# OpenAI: https://platform.openai.com/api-keys (GPT-4o-mini, ~$0.15/M input)
# Anthropic: https://console.anthropic.com/settings/keys (Claude Haiku, fallback)
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
