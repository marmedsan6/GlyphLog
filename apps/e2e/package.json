{
  "name": "@glyphlog/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "E2E tests for GlyphLog using Playwright + Page Object Model",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:e2e": "playwright test --project=chromium",
    "test:report": "playwright show-report",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.33",
    "dotenv": "^16.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
