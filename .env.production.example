# ─────────────────────────────────────────────────────────────────────────────
# GlyphLog — Variables de entorno de PRODUCCIÓN
#
# ⚠️  ESTE ARCHIVO ES UNA PLANTILLA (placeholders).
#     NO contiene secretos reales. Es seguro commitearlo al repo.
#
# INSTRUCCIONES:
#   1. Este archivo es solo de REFERENCIA. Se commitea al repo como plantilla.
#   2. En el SERVIDOR de producción, crea `.env.production` (sin el .example)
#      con los valores reales y NUNCA lo commitees.
#   3. Este archivo está en .gitignore (regla `.env.*` cubre `.env.production`).
#
# UBICACIÓN EN EL SERVIDOR:
#   ~/GlyphLog/.env.production  (en el mismo directorio que docker-compose.prod.yml)
#
# GENERACIÓN DE SECRETOS:
#   SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
#   POSTGRES_PASSWORD: openssl rand -hex 24
#
# REFERENCIADO POR:
#   - docker-compose.prod.yml (env_file: .env.production)
#   - nginx build args (VITE_GOOGLE_CLIENT_ID)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ────────────────────────────────────────────────────────────
# DSN de PostgreSQL usando el nombre del servicio docker 'postgres' (no localhost).
# El contenedor de la API resuelve 'postgres' dentro de la red Docker.
DATABASE_URL=postgresql+asyncpg://glyphlog:REEMPLAZAR_PASSWORD@postgres:5432/glyphlog
POSTGRES_USER=glyphlog
POSTGRES_PASSWORD=REEMPLAZAR_PASSWORD
POSTGRES_DB=glyphlog

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Clave secreta para firmar tokens. MÍNIMO 32 caracteres.
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=38dc310451d28c5cc084c012baeaa88e8a5f40e3f60935d0bcf89f6b400b068e

# Algoritmo de firma JWT. HS256 es el estándar.
ALGORITHM=HS256

# Minutos de validez del token. 60 = 1 hora.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Configuración de la aplicación ──────────────────────────────────────────
# SIEMPRE false en producción — desactiva Swagger UI, ReDoc y logs SQL detallados.
DEBUG=false

# Orígenes permitidos para CORS. NUNCA usar *.
# Formato JSON: lista de strings. pydantic-settings 2.x parsea automáticamente.
ALLOWED_ORIGINS=["https://glyphlog.qzz.io"]

# ─── Google OAuth (opcional) ────────────────────────────────────────────────
# Client ID de la aplicación web creada en Google Cloud Console.
# Se usa en DOS sitios:
#   1. GOOGLE_CLIENT_ID → backend, valida id_tokens en /auth/google
#   2. VITE_GOOGLE_CLIENT_ID → build arg del frontend, inicializa Google Identity Services
# Si se deja vacío: el botón de Google no se renderiza, /auth/google responde 503.
#
# Cómo obtenerlo:
#   1. https://console.cloud.google.com → crear proyecto "GlyphLog"
#   2. APIs & Services → OAuth consent screen → External → scopes: email, profile, openid
#   3. Credentials → Create OAuth client ID → Web application
#   4. Authorized JavaScript origins: http://localhost:5173, https://glyphlog.qzz.io
#   5. Copiar el "Client ID" (formato: xxxxx.apps.googleusercontent.com)
#
# Ver docs/tasks/google-oauth-cloud-setup.md para guía detallada.
GOOGLE_CLIENT_ID=891980338974-gfirv1ufi0lm34gtt0tuvvsdg2nkrom4.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=891980338974-gfirv1ufi0lm34gtt0tuvvsdg2nkrom4.apps.googleusercontent.com
