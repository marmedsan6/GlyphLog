# GlyphLog — plantilla de variables de PRODUCCIÓN
#
# Este archivo no contiene secretos reales y es seguro para Git.
# Crea .env.production en el servidor, aplica chmod 600 y sustituye todos los
# valores REPLACE_* antes de ejecutar el despliegue.

# Base de datos
DATABASE_URL=postgresql+asyncpg://glyphlog:REPLACE_DATABASE_PASSWORD@postgres:5432/glyphlog
POSTGRES_USER=glyphlog
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
POSTGRES_DB=glyphlog

# JWT
SECRET_KEY=REPLACE_GENERATE_WITH_SECRETS_TOKEN_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Aplicación
DEBUG=false
ALLOWED_ORIGINS=["https://glyphlog.qzz.io"]

# Google OAuth: el Client ID no es un secreto, pero debe coincidir en backend y frontend.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# IGDB / Twitch
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# YouTube
YOUTUBE_API_KEY=

# GlyphAI
AI_PROVIDER=bedrock
AI_COMPLETION_PROVIDER=bedrock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Rate limiting: mantener defaults estrictos en producción.
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
